        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "CadenceWindow",
      "type": "object"
    },
    "CadenceWindows": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/CadenceWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "during": {
          "anyOf": [
            {
              "$ref": "#/$defs/CadenceWindow"
            },
            {
              "type": "null"
            }
