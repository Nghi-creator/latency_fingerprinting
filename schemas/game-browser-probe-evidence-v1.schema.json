          ],
          "title": "Jitterbufferemittedcount"
        },
        "keyFramesDecoded": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Keyframesdecoded"
        },
        "packetsLost": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Packetslost"
        },
        "totalDecodeTime": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Totaldecodetime"
        },
        "totalFreezesDuration": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Totalfreezesduration"
        }
      },
      "required": [
        "framesReceived",
        "framesDecoded",
        "framesDropped",
        "freezeCount",
        "totalFreezesDuration",
        "totalDecodeTime",
        "jitterBufferDelay",
        "jitterBufferEmittedCount",
        "frameWidth",
        "frameHeight",
        "keyFramesDecoded",
        "packetsLost",
        "bytesReceived"
      ],
      "title": "BrowserCounters",
      "type": "object"
    },
    "BrowserFrame": {
      "additionalProperties": false,
      "properties": {
        "browser_at_ns": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Browser At Ns",
          "type": "integer"
        },
        "height": {
          "maximum": 480,
          "minimum": 480,
          "title": "Height",
          "type": "integer"
        },
        "presented_frames": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Presented Frames",
          "type": "integer"
        },
        "pts_ns": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Pts Ns",
          "type": "integer"
        },
        "type": {
          "const": "frame",
          "title": "Type",
          "type": "string"
        },
        "width": {
          "maximum": 640,
          "minimum": 640,
          "title": "Width",
          "type": "integer"
        },
        "worker_at_ns": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Worker At Ns",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "pts_ns",
        "browser_at_ns",
        "presented_frames",
        "width",
        "height",
        "worker_at_ns"
      ],
      "title": "BrowserFrame",
      "type": "object"
    },
    "BrowserStats": {
      "additionalProperties": false,
      "properties": {
        "browser_at_ns": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Browser At Ns",
          "type": "integer"
        },
        "type": {
          "const": "stats",
          "title": "Type",
          "type": "string"
        },
        "values": {
          "$ref": "#/$defs/BrowserCounters"
        },
        "worker_at_ns": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Worker At Ns",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "browser_at_ns",
        "values",
        "worker_at_ns"
      ],
      "title": "BrowserStats",
      "type": "object"
    },
    "BrowserVisual": {
      "additionalProperties": false,
      "properties": {
        "browser_at_ns": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Browser At Ns",
