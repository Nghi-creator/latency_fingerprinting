        "rate_tolerance_percent",
        "maximum_game_inputs",
        "maximum_browser_frames_dropped",
        "maximum_browser_freeze_count",
        "minimum_visual_color_bins",
        "warmup_ns",
        "baseline_measure_ns",
        "restoration_measure_ns",
