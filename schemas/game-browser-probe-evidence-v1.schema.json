      "type": "object"
    },
    "GameBrowserAcquisition": {
      "additionalProperties": false,
      "properties": {
        "bounded_stderr_hash": {
          "pattern": "^(?:sha256:[a-f0-9]{64})$",
          "title": "Bounded Stderr Hash",
          "type": "string"
        },
        "browser_clock_basis": {
          "const": "browser_performance_relative_ns",
          "title": "Browser Clock Basis",
          "type": "string"
        },
        "browser_resource_error": {
          "anyOf": [
            {
              "const": "counter_unavailable",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Browser Resource Error"
        },
        "browser_resources": {
          "items": {
            "$ref": "#/$defs/HostBrowserResources"
          },
          "maxItems": 128,
          "title": "Browser Resources",
          "type": "array"
        },
        "browser_version": {
          "anyOf": [
            {
              "pattern": "^(?:[0-9]{1,4}(?:\\.[0-9]{1,6}){2,3})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Browser Version"
        },
        "clock_alignment": {
          "const": "none",
          "title": "Clock Alignment",
          "type": "string"
        },
        "container_cleanup": {
          "enum": [
            "removed_or_already_removed",
            "unknown"
          ],
          "title": "Container Cleanup",
          "type": "string"
        },
        "failure": {
          "anyOf": [
            {
              "enum": [
                "setup_failed",
                "worker_failed",
                "browser_cleanup_failed",
                "container_cleanup_failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure"
        },
        "host_clock_basis": {
          "const": "harness_monotonic_relative_ns",
          "title": "Host Clock Basis",
          "type": "string"
        },
        "image_hash": {
          "pattern": "^(?:sha256:[a-f0-9]{64})$",
          "title": "Image Hash",
          "type": "string"
        },
        "live_authority": {
          "const": false,
          "title": "Live Authority",
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "changed",
            "sham",
            "cancel",
            "disconnect"
          ],
          "title": "Mode",
          "type": "string"
        },
        "receiver_screenshot_hash": {
          "anyOf": [
            {
              "pattern": "^(?:sha256:[a-f0-9]{64})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receiver Screenshot Hash"
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/GameBrowserReport"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_hashes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceBinding"
          },
          "maxItems": 32,
          "title": "Source Hashes",
          "type": "array"
        },
        "stderr_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Stderr Bytes",
          "type": "integer"
        },
        "version": {
          "const": "n10-game-browser-acquisition-v1",
          "title": "Version",
          "type": "string"
        },
        "worker_clock_basis": {
          "const": "worker_monotonic_relative_ns",
          "title": "Worker Clock Basis",
          "type": "string"
        },
        "worker_exit_code": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": -255,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Worker Exit Code"
        }
      },
      "required": [
        "version",
        "mode",
        "image_hash",
        "live_authority",
        "browser_clock_basis",
        "worker_clock_basis",
        "host_clock_basis",
        "clock_alignment",
        "report",
        "browser_resources",
        "container_cleanup",
        "worker_exit_code",
        "failure",
        "stderr_bytes",
        "bounded_stderr_hash"
      ],
      "title": "GameBrowserAcquisition",
      "type": "object"
    },
