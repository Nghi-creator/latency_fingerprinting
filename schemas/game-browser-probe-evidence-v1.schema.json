    "GameBrowserReport": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeclaredGameAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "browser_stats": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BrowserStats"
          },
          "maxItems": 128,
          "title": "Browser Stats",
          "type": "array"
        },
        "diagnostic_value": {
          "const": "unverified",
          "title": "Diagnostic Value",
          "type": "string"
        },
        "dimensions": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 640,
              "minimum": 640,
              "type": "integer"
            },
            {
              "maximum": 480,
              "minimum": 480,
              "type": "integer"
            }
          ],
          "title": "Dimensions",
          "type": "array"
        },
        "game_inputs": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 0,
              "type": "integer"
