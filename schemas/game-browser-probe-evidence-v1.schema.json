      ],
      "title": "BrowserVisual",
      "type": "object"
    },
    "CadenceGeneration": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_-]{0,127})$",
          "title": "Owner",
          "type": "string"
        },
        "peer": {
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_-]{0,127})$",
          "title": "Peer",
          "type": "string"
        },
        "pipeline": {
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_-]{0,127})$",
          "title": "Pipeline",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "pipeline",
        "peer"
      ],
      "title": "CadenceGeneration",
      "type": "object"
    },
    "CadenceObservation": {
      "additionalProperties": false,
      "properties": {
        "at_ns": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "At Ns",
          "type": "integer"
        },
        "capture_buffers": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Capture Buffers",
          "type": "integer"
        },
        "configured_fps": {
          "maximum": 60,
          "minimum": 24,
          "title": "Configured Fps",
          "type": "integer"
        },
        "healthy": {
          "title": "Healthy",
          "type": "boolean"
        },
        "negotiated_fps": {
          "maximum": 60,
          "minimum": 24,
          "title": "Negotiated Fps",
          "type": "integer"
        },
        "receiver_frames": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Receiver Frames",
          "type": "integer"
        },
        "settings_hash": {
          "pattern": "^(?:[a-f0-9]{64})$",
          "title": "Settings Hash",
          "type": "string"
        }
      },
      "required": [
        "at_ns",
        "configured_fps",
        "negotiated_fps",
        "capture_buffers",
        "receiver_frames",
        "healthy",
        "settings_hash"
      ],
      "title": "CadenceObservation",
      "type": "object"
    },
    "CadenceOutcome": {
      "additionalProperties": false,
      "properties": {
        "live_authority": {
          "const": false,
          "title": "Live Authority",
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "completed",
            "aborted",
            "unknown",
            "interrupted_teardown"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "enum": [
            "duration_elapsed",
            "cancelled",
            "health_abort",
            "apply_failed",
            "restore_failed",
            "generation_changed",
            "journal_failed",
            "worker_terminated"
          ],
          "title": "Reason",
          "type": "string"
        },
        "request_id": {
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_-]{0,127})$",
          "title": "Request Id",
          "type": "string"
        },
        "restoration": {
          "enum": [
            "verified_by_port",
            "unknown",
            "not_verified_teardown"
          ],
          "title": "Restoration",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "outcome",
        "restoration",
        "reason",
        "live_authority"
      ],
      "title": "CadenceOutcome",
      "type": "object"
    },
    "CadenceReceipt": {
      "additionalProperties": false,
      "properties": {
        "after_ns": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "After Ns"
        },
        "before_ns": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Before Ns",
          "type": "integer"
        },
        "requested_fps": {
          "maximum": 60,
          "minimum": 24,
          "title": "Requested Fps",
          "type": "integer"
        }
      },
      "required": [
        "requested_fps",
        "before_ns",
        "after_ns"
      ],
