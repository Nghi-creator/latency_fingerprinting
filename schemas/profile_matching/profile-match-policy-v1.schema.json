        "group_prediction": {
          "const": "unanimous_nonduplicate_response_decisions",
          "title": "Group Prediction",
          "type": "string"
        },
        "modes": {
          "items": {
            "enum": [
              "validation",
              "final_test",
              "leave_training_group_out"
            ],
            "type": "string"
