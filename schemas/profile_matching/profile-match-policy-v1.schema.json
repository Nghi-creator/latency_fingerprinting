          "maxItems": 3,
          "title": "Modes",
          "type": "array"
        },
        "refit": {
          "const": "remove_whole_component_then_n7_statistics",
          "title": "Refit",
          "type": "string"
        },
        "trust_promotion": {
          "title": "Trust Promotion",
          "type": "boolean"
        },
        "truth_coverage": {
          "const": "known_truth_groups_over_all_response_groups",
          "title": "Truth Coverage",
          "type": "string"
        },
        "truth_invalid_reasons": {
          "items": {
            "enum": [
              "label_unverified",
              "effect_unverified",
              "binding_unverified"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Truth Invalid Reasons",
          "type": "array"
        },
        "unknown_rate": {
          "const": "unknown_groups_over_all_response_groups",
          "title": "Unknown Rate",
          "type": "string"
        },
        "voting_unit": {
          "const": "one_n6_source_group",
          "title": "Voting Unit",
          "type": "string"
