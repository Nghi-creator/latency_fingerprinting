{
  "$defs": {
    "AggregationKind": {
      "enum": [
        "median",
        "nearest_rank_p95",
        "minimum",
        "maximum",
        "window_total",
        "time_weighted_rate"
      ],
      "title": "AggregationKind",
      "type": "string"
    },
    "AnalyticalDecisionPolicyV1": {
      "additionalProperties": false,
      "properties": {
        "conflictingResidualThreshold": {
          "exclusiveMinimum": 0,
          "title": "Conflictingresidualthreshold",
          "type": "number"
        },
        "maximumConflictContribution": {
          "maximum": 1,
          "minimum": 0,
          "title": "Maximumconflictcontribution",
          "type": "number"
        },
        "minimumFeatureCoverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Minimumfeaturecoverage",
          "type": "number"
        },
        "minimumMatchStrength": {
          "maximum": 1,
          "minimum": 0,
          "title": "Minimummatchstrength",
          "type": "number"
        },
        "minimumScoreMargin": {
          "maximum": 1,
          "minimum": 0,
          "title": "Minimumscoremargin",
          "type": "number"
        },
        "minimumSharedFeatures": {
          "exclusiveMinimum": 0,
          "title": "Minimumsharedfeatures",
          "type": "integer"
        }
      },
      "required": [
        "minimumSharedFeatures",
        "minimumFeatureCoverage",
        "minimumMatchStrength",
        "minimumScoreMargin",
        "conflictingResidualThreshold",
        "maximumConflictContribution"
      ],
      "title": "AnalyticalDecisionPolicyV1",
      "type": "object"
    },
    "CaptureMethodReference": {
      "additionalProperties": false,
      "properties": {
        "methodId": {
          "enum": [
            "pixelated_bundle_offline",
            "synthetic_series"
          ],
          "title": "Methodid",
          "type": "string"
        },
        "methodVersion": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Methodversion",
          "type": "string"
        },
        "producerVersion": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Producerversion"
        }
      },
      "required": [
        "methodId",
        "methodVersion",
        "producerVersion"
      ],
      "title": "CaptureMethodReference",
      "type": "object"
    },
    "ClockBasis": {
      "description": "The exported elapsed field; monotonic provenance is not implied.",
      "enum": [
        "source_elapsed_ms"
      ],
      "title": "ClockBasis",
      "type": "string"
    },
    "CounterInterval": {
      "additionalProperties": false,
      "description": "Accepted counter transition; rate units are declared by its summary.",
      "properties": {
        "delta": {
          "minimum": 0,
          "title": "Delta",
          "type": "number"
        },
        "durationMs": {
          "exclusiveMinimum": 0,
          "title": "Durationms",
          "type": "number"
        },
        "endElapsedMs": {
          "minimum": 0,
          "title": "Endelapsedms",
          "type": "number"
        },
        "endSourceRow": {
          "exclusiveMinimum": 0,
          "title": "Endsourcerow",
          "type": "integer"
        },
        "rate": {
          "minimum": 0,
          "title": "Rate",
          "type": "number"
        },
        "startElapsedMs": {
          "minimum": 0,
          "title": "Startelapsedms",
          "type": "number"
        },
        "startSourceRow": {
          "exclusiveMinimum": 0,
          "title": "Startsourcerow",
          "type": "integer"
        },
        "wrapped": {
          "default": false,
          "title": "Wrapped",
          "type": "boolean"
        }
      },
      "required": [
        "startSourceRow",
        "endSourceRow",
        "startElapsedMs",
        "endElapsedMs",
        "durationMs",
        "delta",
        "rate"
      ],
      "title": "CounterInterval",
      "type": "object"
    },
    "FeaturePolicyParameterV1": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "$ref": "#/$defs/AggregationKind"
        },
        "allowedStatuses": {
          "items": {
            "const": "complete",
            "type": "string"
          },
          "title": "Allowedstatuses",
          "type": "array"
        },
        "clipMaximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Clipmaximum"
        },
        "clipMinimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Clipminimum"
        },
        "epsilon": {
          "exclusiveMinimum": 0,
          "title": "Epsilon",
          "type": "number"
        },
        "minimumAcceptedIntervals": {
          "exclusiveMinimum": 0,
          "title": "Minimumacceptedintervals",
          "type": "integer"
        },
        "minimumCoverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Minimumcoverage",
          "type": "number"
        },
        "minimumUsableSamples": {
          "exclusiveMinimum": 0,
          "title": "Minimumusablesamples",
          "type": "integer"
        },
        "semanticVersion": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Semanticversion",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/MetricSource"
        },
        "unit": {
          "$ref": "#/$defs/MetricUnit"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "semanticVersion",
        "source",
        "unit",
        "aggregation",
        "epsilon",
        "weight",
        "clipMinimum",
        "clipMaximum",
        "minimumCoverage",
        "minimumUsableSamples",
        "minimumAcceptedIntervals",
        "allowedStatuses"
      ],
      "title": "FeaturePolicyParameterV1",
      "type": "object"
    },
    "FeaturePolicyV1": {
      "additionalProperties": false,
      "properties": {
        "compatibilityMethod": {
          "const": "structural_context_probe_v1",
          "title": "Compatibilitymethod",
          "type": "string"
        },
        "confounderHandling": {
          "const": "reject_pair",
          "title": "Confounderhandling",
          "type": "string"
        },
        "contentHash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Contenthash",
          "type": "string"
        },
        "contractVersion": {
          "const": "1.0.0",
          "title": "Contractversion",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/AnalyticalDecisionPolicyV1"
        },
        "deltaDirection": {
          "const": "relief_minus_degraded",
          "title": "Deltadirection",
          "type": "string"
        },
        "distanceMethod": {
          "const": "weighted_rms_v1",
          "title": "Distancemethod",
          "type": "string"
        },
        "features": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$": {
              "$ref": "#/$defs/FeaturePolicyParameterV1"
            }
          },
          "title": "Features",
          "type": "object"
        },
        "maximumRankedCandidates": {
          "exclusiveMinimum": 0,
          "title": "Maximumrankedcandidates",
          "type": "integer"
        },
        "normalizationReference": {
          "const": "absolute_degraded_with_epsilon_floor",
          "title": "Normalizationreference",
          "type": "string"
        },
        "parameterProvenance": {
          "const": "software_provisional",
          "title": "Parameterprovenance",
          "type": "string"
        },
        "policyId": {
          "const": "n3-offline-conservative",
          "title": "Policyid",
          "type": "string"
        },
        "policyVersion": {
          "const": "1.0.0",
          "title": "Policyversion",
          "type": "string"
        },
        "registry": {
          "$ref": "#/$defs/RegistryReference"
        },
        "repositoryFailurePolicy": {
          "const": "error",
          "title": "Repositoryfailurepolicy",
          "type": "string"
        },
        "responseMethod": {
          "const": "signed_relative_primary_v1",
          "title": "Responsemethod",
          "type": "string"
        },
        "schemaVersion": {
          "const": "feature-policy-v1",
          "title": "Schemaversion",
          "type": "string"
        },
        "strengthMethod": {
          "const": "inverse_one_plus_distance_v1",
          "title": "Strengthmethod",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "contractVersion",
        "policyId",
        "policyVersion",
        "contentHash",
        "parameterProvenance",
        "registry",
        "responseMethod",
        "deltaDirection",
        "normalizationReference",
        "confounderHandling",
        "compatibilityMethod",
        "distanceMethod",
        "strengthMethod",
        "repositoryFailurePolicy",
        "maximumRankedCandidates",
        "decision",
        "features"
      ],
      "title": "FeaturePolicyV1",
      "type": "object"
    },
    "FeatureResponseV2": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "$ref": "#/$defs/AggregationKind"
        },
        "degraded": {
          "$ref": "#/$defs/WindowFeatureEvidenceV2"
        },
        "denominator": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Denominator"
        },
        "exclusionCodes": {
          "items": {
            "enum": [
              "confounded_pair",
              "degraded_unsupported",
              "degraded_unavailable",
              "degraded_missing",
              "degraded_rejected",
              "degraded_incomplete",
              "degraded_coverage",
              "degraded_samples",
              "degraded_intervals",
              "degraded_no_value",
              "relief_unsupported",
              "relief_unavailable",
              "relief_missing",
              "relief_rejected",
              "relief_incomplete",
              "relief_coverage",
              "relief_samples",
              "relief_intervals",
              "relief_no_value"
            ],
            "type": "string"
          },
          "title": "Exclusioncodes",
          "type": "array"
        },
        "normalizedValue": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Normalizedvalue"
        },
        "rawDelta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rawdelta"
        },
        "referenceValue": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Referencevalue"
        },
        "relief": {
          "$ref": "#/$defs/WindowFeatureEvidenceV2"
        },
        "state": {
          "enum": [
            "eligible",
            "excluded"
          ],
          "title": "State",
          "type": "string"
        },
        "unclippedValue": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unclippedvalue"
        },
        "unit": {
          "$ref": "#/$defs/MetricUnit"
        },
        "wasClipped": {
          "title": "Wasclipped",
          "type": "boolean"
        }
      },
      "required": [
        "unit",
        "aggregation",
        "state",
        "degraded",
        "relief",
        "exclusionCodes",
        "rawDelta",
        "referenceValue",
        "denominator",
        "normalizedValue",
        "wasClipped",
        "unclippedValue"
      ],
      "title": "FeatureResponseV2",
      "type": "object"
    },
    "InterventionV2": {
      "additionalProperties": false,
      "properties": {
        "applicationMethod": {
          "enum": [
            "paired_run",
            "simulated_pair"
          ],
          "title": "Applicationmethod",
          "type": "string"
        },
        "confounderCodes": {
          "default": [],
          "items": {
            "enum": [
              "composite_profile_change",
              "other_setting_change",
              "operator_declared"
            ],
            "type": "string"
          },
          "title": "Confoundercodes",
          "type": "array"
        },
        "degradedWindowId": {
          "minLength": 1,
          "title": "Degradedwindowid",
          "type": "string"
        },
        "executionStatus": {
          "enum": [
            "not_executed",
            "executed",
            "failed"
          ],
          "title": "Executionstatus",
          "type": "string"
        },
        "intensity": {
          "exclusiveMinimum": 0,
          "title": "Intensity",
          "type": "number"
        },
        "observedSettings": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "propertyNames": {
                "minLength": 1
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observedsettings"
        },
        "pairedWindowOrder": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "degraded",
              "type": "string"
            },
            {
              "const": "relief",
              "type": "string"
            }
          ],
          "title": "Pairedwindoworder",
          "type": "array"
        },
        "probeId": {
          "minLength": 1,
          "title": "Probeid",
          "type": "string"
        },
        "probeType": {
          "const": "stream_profile_relief",
          "title": "Probetype",
          "type": "string"
        },
        "probeVersion": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Probeversion",
          "type": "string"
        },
        "reliefWindowId": {
          "minLength": 1,
          "title": "Reliefwindowid",
          "type": "string"
        },
        "requestedSettings": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Requestedsettings",
          "type": "object"
        },
        "restorationStatus": {
          "$ref": "#/$defs/RestorationStatus"
        }
      },
      "required": [
        "probeId",
        "probeType",
        "probeVersion",
        "requestedSettings",
        "observedSettings",
        "intensity",
        "applicationMethod",
        "executionStatus",
        "restorationStatus",
        "degradedWindowId",
        "reliefWindowId",
        "pairedWindowOrder"
      ],
      "title": "InterventionV2",
      "type": "object"
    },
    "JsonValue": {},
    "MetricKind": {
      "enum": [
        "gauge",
        "cumulative_counter",
        "event_count",
        "derived"
      ],
      "title": "MetricKind",
      "type": "string"
    },
    "MetricMeasurement": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "analytical_candidate",
            "audit_only"
          ],
          "title": "Role",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/MetricSeriesSummary"
        },
        "support": {
          "$ref": "#/$defs/MetricSupport"
        }
      },
      "required": [
        "role",
        "support",
        "summary"
      ],
      "title": "MetricMeasurement",
      "type": "object"
    },
    "MetricSeriesStatus": {
      "enum": [
        "complete",
        "incomplete",
        "missing",
        "rejected"
      ],
      "title": "MetricSeriesStatus",
      "type": "string"
    },
    "MetricSeriesSummary": {
      "additionalProperties": false,
      "description": "Immutable, finite aggregation result with reconstructable source evidence.",
      "properties": {
        "acceptedIntervalCount": {
          "minimum": 0,
          "title": "Acceptedintervalcount",
          "type": "integer"
        },
        "aggregates": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/AggregationKind"
          },
          "title": "Aggregates",
          "type": "object"
        },
        "availableAggregations": {
          "items": {
            "$ref": "#/$defs/AggregationKind"
          },
          "minItems": 1,
          "title": "Availableaggregations",
          "type": "array"
        },
        "cadenceMaximumMs": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cadencemaximumms"
        },
        "cadenceMedianMs": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cadencemedianms"
        },
        "cadenceMinimumMs": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cadenceminimumms"
        },
        "canonicalUnit": {
          "$ref": "#/$defs/MetricUnit"
        },
        "clockBasis": {
          "$ref": "#/$defs/ClockBasis"
        },
        "counterIntervals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CounterInterval"
          },
          "title": "Counterintervals",
          "type": "array"
        },
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "gapSourceRows": {
          "default": [],
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "title": "Gapsourcerows",
          "type": "array"
        },
        "intervalRateUnit": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricUnit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/MetricKind"
        },
        "metricName": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Metricname",
          "type": "string"
        },
        "missingReasons": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missingreasons",
          "type": "array"
        },
        "observedDurationMs": {
          "minimum": 0,
          "title": "Observeddurationms",
          "type": "number"
        },
        "primaryAggregation": {
          "$ref": "#/$defs/AggregationKind"
        },
        "rawFields": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Rawfields",
          "type": "array"
        },
        "registryVersion": {
          "pattern": "^latency-metrics-v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Registryversion",
          "type": "string"
        },
        "rejectedReasons": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Rejectedreasons",
          "type": "array"
        },
        "resetSourceRows": {
          "default": [],
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "title": "Resetsourcerows",
          "type": "array"
        },
        "semanticVersion": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Semanticversion",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/MetricSource"
        },
        "sourceSampleCount": {
          "minimum": 0,
          "title": "Sourcesamplecount",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/MetricSeriesStatus"
        },
        "usableSampleCount": {
          "minimum": 0,
          "title": "Usablesamplecount",
          "type": "integer"
        },
        "usableSourceRows": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "title": "Usablesourcerows",
          "type": "array"
        },
        "warnings": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "windowDurationMs": {
          "exclusiveMinimum": 0,
          "title": "Windowdurationms",
          "type": "number"
        },
        "windowEndMs": {
          "minimum": 0,
          "title": "Windowendms",
          "type": "number"
        },
        "windowStartMs": {
          "minimum": 0,
          "title": "Windowstartms",
          "type": "number"
        }
      },
      "required": [
        "metricName",
        "semanticVersion",
        "registryVersion",
        "source",
        "rawFields",
        "kind",
        "canonicalUnit",
        "primaryAggregation",
        "availableAggregations",
        "clockBasis",
        "windowStartMs",
        "windowEndMs",
        "windowDurationMs",
        "sourceSampleCount",
        "usableSampleCount",
        "usableSourceRows",
        "acceptedIntervalCount",
        "observedDurationMs",
        "coverage",
        "cadenceMinimumMs",
        "cadenceMedianMs",
        "cadenceMaximumMs",
        "status"
      ],
      "title": "MetricSeriesSummary",
      "type": "object"
    },
    "MetricSource": {
      "enum": [
        "browser_webrtc",
        "engine_runtime",
        "encoder_pipeline"
      ],
      "title": "MetricSource",
      "type": "string"
    },
    "MetricSupport": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "measurement_declaration",
            "source_support",
            "source_rows"
          ],
          "title": "Basis",
          "type": "string"
        },
        "declaredState": {
          "anyOf": [
            {
              "enum": [
                "supported",
                "unsupported",
                "unavailable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Declaredstate"
        },
        "state": {
          "enum": [
            "supported",
            "unsupported",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "declaredState",
        "basis"
      ],
      "title": "MetricSupport",
      "type": "object"
    },
    "MetricUnit": {
      "enum": [
        "fps",
        "frames/s",
        "frames",
        "freezes/min",
        "freezes",
        "ms/s",
        "ms",
        "packets/s",
        "packets",
        "kbps",
        "percent",
        "MiB",
        "buffers"
      ],
      "title": "MetricUnit",
      "type": "string"
    },
    "ObservationRecordV2": {
      "additionalProperties": false,
      "properties": {
        "comparisonCaseId": {
          "minLength": 1,
          "title": "Comparisoncaseid",
          "type": "string"
        },
        "contractVersion": {
          "const": "2.0.0",
          "title": "Contractversion",
          "type": "string"
        },
        "degradedWindow": {
