{
  "$defs": {
    "CompatibilityKey": {
      "additionalProperties": false,
      "properties": {
        "compatibilityGroup": {
          "minLength": 1,
          "title": "Compatibilitygroup",
          "type": "string"
        },
        "contractVersion": {
          "default": "1.0.0",
          "minLength": 1,
          "title": "Contractversion",
          "type": "string"
        },
        "probeType": {
          "minLength": 1,
          "title": "Probetype",
          "type": "string"
        }
      },
      "required": [
        "compatibilityGroup",
        "probeType"
      ],
      "title": "CompatibilityKey",
      "type": "object"
    },
    "ContextKey": {
      "additionalProperties": false,
      "description": "The explicit boundary within which P0 records may be compared.",
      "properties": {
        "captureImplementation": {
          "minLength": 1,
          "title": "Captureimplementation",
          "type": "string"
        },
        "clientClass": {
          "minLength": 1,
          "title": "Clientclass",
          "type": "string"
        },
        "compatibilityGroup": {
          "minLength": 1,
          "title": "Compatibilitygroup",
          "type": "string"
        },
        "connectionMode": {
          "minLength": 1,
          "title": "Connectionmode",
          "type": "string"
        },
        "contextId": {
          "minLength": 1,
          "title": "Contextid",
          "type": "string"
        },
        "edgeNodeClass": {
          "minLength": 1,
          "title": "Edgenodeclass",
          "type": "string"
        },
        "encoderFamily": {
          "minLength": 1,
