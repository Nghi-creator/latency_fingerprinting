          "title": "Features",
          "type": "object"
        }
      },
      "required": [
        "features"
      ],
      "title": "NormalizedResponse",
      "type": "object"
    },
    "ProvenanceKind": {
      "enum": [
        "synthetic",
        "controlled_real",
        "organic_real"
      ],
      "title": "ProvenanceKind",
      "type": "string"
    },
    "ResponseDelta": {
      "additionalProperties": false,
      "properties": {
        "degradedWindowId": {
          "minLength": 1,
          "title": "Degradedwindowid",
          "type": "string"
        },
        "features": {
          "additionalProperties": {
            "$ref": "#/$defs/FeatureDelta"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Features",
          "type": "object"
        },
        "invalidReasons": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Invalidreasons",
          "type": "array"
        },
        "isValid": {
          "title": "Isvalid",
          "type": "boolean"
        },
        "reliefWindowId": {
          "minLength": 1,
          "title": "Reliefwindowid",
          "type": "string"
        }
      },
      "required": [
        "degradedWindowId",
        "reliefWindowId",
        "features",
        "isValid"
      ],
