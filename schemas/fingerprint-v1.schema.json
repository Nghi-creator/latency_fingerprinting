      "title": "FeatureDelta",
      "type": "object"
    },
    "JsonValue": {},
    "NormalizedFeature": {
      "additionalProperties": false,
      "properties": {
        "epsilon": {
          "exclusiveMinimum": 0,
          "title": "Epsilon",
          "type": "number"
        },
        "referenceValue": {
          "title": "Referencevalue",
          "type": "number"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "wasClipped": {
          "default": false,
          "title": "Wasclipped",
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "epsilon",
        "referenceValue"
      ],
      "title": "NormalizedFeature",
      "type": "object"
    },
    "NormalizedResponse": {
      "additionalProperties": false,
      "properties": {
        "features": {
