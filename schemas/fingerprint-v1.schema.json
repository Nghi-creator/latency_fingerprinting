          "type": "object"
        },
        "operatingSystem": {
          "minLength": 1,
          "title": "Operatingsystem",
          "type": "string"
        },
        "runtimeClass": {
          "minLength": 1,
          "title": "Runtimeclass",
          "type": "string"
        },
        "transportImplementation": {
          "minLength": 1,
          "title": "Transportimplementation",
          "type": "string"
        },
        "versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Versions",
          "type": "object"
        },
        "workloadId": {
          "minLength": 1,
          "title": "Workloadid",
          "type": "string"
        }
