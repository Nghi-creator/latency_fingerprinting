      "title": "ContextKey",
      "type": "object"
    },
    "FeatureDelta": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "minLength": 1,
          "title": "Aggregation",
          "type": "string"
        },
        "degradedValue": {
          "title": "Degradedvalue",
          "type": "number"
        },
        "rawDelta": {
          "title": "Rawdelta",
          "type": "number"
        },
        "reliefValue": {
          "title": "Reliefvalue",
          "type": "number"
        },
