      "type": "object"
    },
    "ValidationStatus": {
      "enum": [
        "unvalidated",
        "software_test_reference",
        "validated",
        "rejected"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bottleneckLabel": {
      "minLength": 1,
      "title": "Bottlenecklabel",
      "type": "string"
    },
    "compatibility": {
      "$ref": "#/$defs/CompatibilityKey"
    },
    "context": {
      "$ref": "#/$defs/ContextKey"
    },
    "contractVersion": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contractversion",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "featureWeights": {
      "additionalProperties": {
        "minimum": 0,
        "type": "number"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Featureweights",
      "type": "object"
    },
    "fingerprintId": {
      "minLength": 1,
      "title": "Fingerprintid",
      "type": "string"
    },
    "normalizedResponse": {
      "$ref": "#/$defs/NormalizedResponse"
    },
    "notes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/ProvenanceKind"
    },
    "rawResponseDelta": {
      "$ref": "#/$defs/ResponseDelta"
    },
    "schemaVersion": {
      "const": "fingerprint-v1",
      "default": "fingerprint-v1",
      "title": "Schemaversion",
      "type": "string"
    },
    "softwareVersion": {
      "minLength": 1,
      "title": "Softwareversion",
      "type": "string"
    },
    "sourceCaseIds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Sourcecaseids",
      "type": "array"
    },
    "sourceRunIds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Sourcerunids",
      "type": "array"
    },
    "sourceWindowIds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Sourcewindowids",
      "type": "array"
    },
    "validationStatus": {
      "$ref": "#/$defs/ValidationStatus"
    }
  },
  "required": [
    "fingerprintId",
    "bottleneckLabel",
    "context",
    "compatibility",
    "rawResponseDelta",
    "normalizedResponse",
    "featureWeights",
    "provenance",
    "sourceCaseIds",
    "sourceWindowIds",
    "createdAt",
    "softwareVersion",
    "validationStatus"
  ],
  "title": "Fingerprint",
  "type": "object"
}
