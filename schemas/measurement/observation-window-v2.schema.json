{
  "$defs": {
    "AggregationKind": {
      "enum": [
        "median",
        "nearest_rank_p95",
        "minimum",
        "maximum",
        "window_total",
        "time_weighted_rate"
      ],
      "title": "AggregationKind",
      "type": "string"
    },
    "CaptureMethodReference": {
      "additionalProperties": false,
      "properties": {
        "methodId": {
          "enum": [
            "pixelated_bundle_offline",
            "synthetic_series"
          ],
          "title": "Methodid",
          "type": "string"
        },
        "methodVersion": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Methodversion",
          "type": "string"
        },
        "producerVersion": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Producerversion"
        }
      },
      "required": [
        "methodId",
        "methodVersion",
        "producerVersion"
      ],
      "title": "CaptureMethodReference",
      "type": "object"
    },
    "ClockBasis": {
      "description": "The exported elapsed field; monotonic provenance is not implied.",
      "enum": [
        "source_elapsed_ms"
      ],
      "title": "ClockBasis",
      "type": "string"
    },
    "CounterInterval": {
      "additionalProperties": false,
      "description": "Accepted counter transition; rate units are declared by its summary.",
      "properties": {
        "delta": {
          "minimum": 0,
          "title": "Delta",
          "type": "number"
        },
        "durationMs": {
          "exclusiveMinimum": 0,
          "title": "Durationms",
          "type": "number"
        },
        "endElapsedMs": {
          "minimum": 0,
          "title": "Endelapsedms",
          "type": "number"
        },
        "endSourceRow": {
          "exclusiveMinimum": 0,
          "title": "Endsourcerow",
          "type": "integer"
        },
        "rate": {
          "minimum": 0,
          "title": "Rate",
          "type": "number"
        },
        "startElapsedMs": {
          "minimum": 0,
          "title": "Startelapsedms",
          "type": "number"
        },
        "startSourceRow": {
          "exclusiveMinimum": 0,
          "title": "Startsourcerow",
          "type": "integer"
        },
        "wrapped": {
          "default": false,
          "title": "Wrapped",
          "type": "boolean"
        }
      },
      "required": [
        "startSourceRow",
        "endSourceRow",
        "startElapsedMs",
        "endElapsedMs",
        "durationMs",
        "delta",
        "rate"
      ],
      "title": "CounterInterval",
      "type": "object"
    },
    "JsonValue": {},
    "MetricKind": {
      "enum": [
        "gauge",
        "cumulative_counter",
        "event_count",
        "derived"
      ],
      "title": "MetricKind",
      "type": "string"
    },
    "MetricMeasurement": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "analytical_candidate",
            "audit_only"
          ],
          "title": "Role",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/MetricSeriesSummary"
        },
        "support": {
          "$ref": "#/$defs/MetricSupport"
        }
      },
      "required": [
        "role",
        "support",
        "summary"
      ],
      "title": "MetricMeasurement",
      "type": "object"
    },
    "MetricSeriesStatus": {
      "enum": [
        "complete",
        "incomplete",
        "missing",
        "rejected"
      ],
      "title": "MetricSeriesStatus",
      "type": "string"
    },
    "MetricSeriesSummary": {
