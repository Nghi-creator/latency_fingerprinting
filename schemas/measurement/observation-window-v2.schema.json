            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "title": "Gapsourcerows",
          "type": "array"
        },
        "intervalRateUnit": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricUnit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/MetricKind"
        },
        "metricName": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Metricname",
          "type": "string"
        },
        "missingReasons": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missingreasons",
          "type": "array"
        },
        "observedDurationMs": {
          "minimum": 0,
          "title": "Observeddurationms",
          "type": "number"
        },
        "primaryAggregation": {
          "$ref": "#/$defs/AggregationKind"
        },
        "rawFields": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Rawfields",
          "type": "array"
        },
        "registryVersion": {
          "pattern": "^latency-metrics-v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Registryversion",
          "type": "string"
        },
        "rejectedReasons": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Rejectedreasons",
          "type": "array"
        },
        "resetSourceRows": {
          "default": [],
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "title": "Resetsourcerows",
          "type": "array"
        },
        "semanticVersion": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Semanticversion",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/MetricSource"
        },
        "sourceSampleCount": {
          "minimum": 0,
          "title": "Sourcesamplecount",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/MetricSeriesStatus"
        },
        "usableSampleCount": {
          "minimum": 0,
          "title": "Usablesamplecount",
          "type": "integer"
        },
        "usableSourceRows": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "title": "Usablesourcerows",
          "type": "array"
        },
        "warnings": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "windowDurationMs": {
          "exclusiveMinimum": 0,
          "title": "Windowdurationms",
          "type": "number"
        },
        "windowEndMs": {
          "minimum": 0,
          "title": "Windowendms",
          "type": "number"
        },
        "windowStartMs": {
          "minimum": 0,
          "title": "Windowstartms",
          "type": "number"
        }
      },
      "required": [
        "metricName",
        "semanticVersion",
        "registryVersion",
        "source",
        "rawFields",
        "kind",
        "canonicalUnit",
        "primaryAggregation",
        "availableAggregations",
        "clockBasis",
        "windowStartMs",
        "windowEndMs",
        "windowDurationMs",
        "sourceSampleCount",
        "usableSampleCount",
        "usableSourceRows",
        "acceptedIntervalCount",
        "observedDurationMs",
        "coverage",
        "cadenceMinimumMs",
        "cadenceMedianMs",
        "cadenceMaximumMs",
        "status"
      ],
      "title": "MetricSeriesSummary",
      "type": "object"
    },
